LLM_BACKEND=openrouter # or google, mock
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-1.5-flash
# REASONING_MODEL=true  # Set to true/1/yes if using a reasoning model (nemotron, deepseek-r1, etc.)

# ── 回應長度控制 ──
# SHORT_CHANCE=0.25       # 短回應基礎機率（1-2句）
# LONG_CHANCE=0.20        # 長回應基礎機率（6-10句，正常但囉嗦）
# VERBOSE_TEMPERATURE=0.92 # 長回應時的 LLM 溫度（越高越有變化）

# ── Token 上限控制（硬截斷） ──
# JUDGE_MAX_OUTPUT_TOKENS=150  # Judge 分類回應最大 token（JSON 格式）
# SHORT_MAX_TOKENS=120         # 短回應（1-2句）最大 token
# MEDIUM_MAX_TOKENS=250        # 中回應（3-5句）最大 token
# LONG_MAX_TOKENS=450          # 長回應（6-10句）最大 token
