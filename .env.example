LLM_BACKEND=openrouter # or google, mock
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-1.5-flash
# REASONING_MODEL=true  # Set to true/1/yes if using a reasoning model (nemotron, deepseek-r1, etc.)

# ── 記憶系統 ──
# MEMORY_MODEL=google/gemini-2.5-pro  # 強模型用於背景摘要（空=fallback 到主模型）
# MEMORY_SUMMARY_THRESHOLD=20          # 待摘要訊息數滿此值才批次摘要（預設 20 = 10 輪）

# ── 回應長度控制 ──
# SHORT_CHANCE=0.25        # 短回應基礎機率（1-2句），調高 → 更常話少
# LONG_CHANCE=0.20         # 長回應基礎機率（4-6句），調高 → 更常發揮
# LONG_LONG_CHANCE=0.0     # 超長回應基礎機率（6-8句），極稀有
# VERBOSE_TEMPERATURE=0.92 # 長回應時的 LLM 溫度（越高越有變化）
# JUDGE_TEMPERATURE=0.1    # Judge 分類溫度，調低 → 分類更穩定（建議 0~0.3）

# ── 回應長度控制（max_tokens 天花板 + smart_truncate 句子邊界截斷） ──
# JUDGE_MAX_OUTPUT_TOKENS=150   # Judge 分類回應最大 token（JSON 格式）
# SHORT_MAX_TOKENS=50           # 短回應（1-2句，每句≤20字）
# MEDIUM_MAX_TOKENS=90          # 中回應（2-3句，每句≤15字）
# LONG_MAX_TOKENS=150           # 長回應（4-6句，每句≤15字）
# LONG_LONG_MAX_TOKENS=250      # 超長回應（6-8句）
